# Copy to .env and fill in. .env is gitignored; this template is not.

# Alibaba Cloud Model Studio / DashScope — Qwen TTS
QWEN_API_KEY=
QWEN_API_HOST=
QWEN_COMPATIBLE_ENDPOINT=
QWEN_DASHSCOPE_ENDPOINT=
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=

# --- json2video ---
JSON2VIDEO_API_KEY=
JSON2VIDEO_ENDPOINT=https://api.json2video.com/v2/movies

# --- remote Adobe machine (optional; defaults live in umcares/config.py) ---
UMC_REMOTE_HOST=
UMC_REMOTE_USER=
UMC_SSH_ALIAS=
UMC_TMUX_SESSION=
UMC_REMOTE_ROOT=
# Prefer `umcares auth --setup-key` over storing a password here.
# If you do set it, install sshpass: brew install hudochenkov/sshpass/sshpass
UMC_SSH_PASSWORD=
UMC_SSH_KEY=~/.ssh/id_ed25519_umcares
