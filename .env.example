# Copy to .env and fill in. .env is gitignored; this template is not.

# Alibaba Cloud Model Studio / DashScope — Qwen TTS
QWEN_API_KEY=
QWEN_API_HOST=
QWEN_COMPATIBLE_ENDPOINT=
QWEN_DASHSCOPE_ENDPOINT=
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=

# --- json2video ---
JSON2VIDEO_API_KEY=
JSON2VIDEO_ENDPOINT=https://api.json2video.com/v2/movies

# --- remote Adobe machine ---------------------------------------------------
# Everything here is optional. `umcares config show` prints the effective value
# of each setting and whether it came from the environment, this file, or a
# built-in default.
UMC_REMOTE_HOST=
UMC_REMOTE_USER=
UMC_SSH_ALIAS=
UMC_TMUX_SESSION=
UMC_TMUX_PANE=
UMC_REMOTE_ROOT=
UMC_MCP_REPO=
UMC_CDP_PORT=

# --- ingest (brief for the recipe author) -----------------------------------
# CSV export URL of the linked Google Sheet (Forms -> Responses -> Link to
# Sheets, share 'anyone with link', copy the `export?format=csv` URL).
UMC_INGEST_CSV_URL=
# NotebookLM notebook URL, referenced in the brief for the author to consult.
UMC_INGEST_NOTEBOOK_URL=

# --- Adobe install + project ------------------------------------------------
# Point UMC_PROJECT at a scratch .prproj to try a recipe without touching a
# finished edit: `umcares premiere build` CLEARS the timeline first.
UMC_PREMIERE_APP=
UMC_CEP_EXT_ID=
UMC_PROJECT=
UMC_PRESET=
# Prefer `umcares auth --setup-key` over storing a password here.
# If you do set it, install sshpass: brew install hudochenkov/sshpass/sshpass
UMC_SSH_PASSWORD=
UMC_SSH_KEY=~/.ssh/id_ed25519_umcares
# One ssh connection reused by every command and by scp (~4x faster over a
# tailnet). Set UMC_SSH_MUX=0 to go back to one connection per command.
UMC_SSH_MUX=
UMC_SSH_PERSIST=10m
